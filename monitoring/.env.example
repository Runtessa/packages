MONITORING_HOST=0.0.0.0
MONITORING_PORT=3011
REDIS_URL=redis://localhost:6379

# Use one of these for auth:
MONITORING_INGEST_TOKEN=change-me
# MONITORING_SERVER_TOKEN=

# TLS (required by default)
MONITORING_TLS_REQUIRED=true
MONITORING_TLS_ENABLED=true
MONITORING_TLS_KEY_PATH=./certs/server.key
MONITORING_TLS_CERT_PATH=./certs/server.crt
MONITORING_TLS_AUTO_SELF_SIGNED=true
MONITORING_TLS_SELF_SIGNED_DAYS=825
MONITORING_TLS_CN=localhost
MONITORING_TLS_CA_PATH=
MONITORING_TLS_MUTUAL=false

# Optional overrides
MONITORING_INSTANCE_TTL_SEC=30
MONITORING_PAYLOAD_LIMIT=2mb

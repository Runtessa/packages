# ---- compose mounts (host -> container) ----
PODMAN_COMPOSE_IN_POD=false
CONTAINER_MANAGER_SOCKET_HOST_PATH=/run/user/1000/podman/podman.sock
CONTAINER_MANAGER_BIND_PORT=4070
CONTAINER_MANAGER_WORKSPACE_MOUNT_PATH=/srv/idp

# ---- manager runtime ----
CONTAINER_MANAGER_HOST=0.0.0.0
CONTAINER_MANAGER_PORT=4070
CONTAINER_MANAGER_TOKEN=change-me
CONTAINER_MANAGER_SOCKET=/var/run/docker.sock
CONTAINER_MANAGER_ENGINE_LABEL=podman

# TLS
CONTAINER_MANAGER_TLS_REQUIRED=true
CONTAINER_MANAGER_TLS_ENABLED=true
CONTAINER_MANAGER_TLS_AUTO_SELF_SIGNED=true
CONTAINER_MANAGER_TLS_KEY_PATH=/app/certs/server.key
CONTAINER_MANAGER_TLS_CERT_PATH=/app/certs/server.crt
CONTAINER_MANAGER_TLS_CA_PATH=
CONTAINER_MANAGER_TLS_MUTUAL=false
CONTAINER_MANAGER_TLS_SELF_SIGNED_DAYS=825
CONTAINER_MANAGER_TLS_CN=localhost

# Built-in managed services
CONTAINER_MANAGER_CODEX_IMAGE=idp/codex-gateway:latest
CONTAINER_MANAGER_MONITORING_IMAGE=idp/monitoring:latest
CONTAINER_MANAGER_MONITORING_REDIS_URL=redis://host.containers.internal:6379
CONTAINER_MANAGER_MONITORING_INGEST_TOKEN=change-me
CONTAINER_MANAGER_CODEX_DATA_VOLUME_PREFIX=idp-codex-gw-data
CONTAINER_MANAGER_MONITORING_DATA_VOLUME=idp-monitoring-data

# Optional override if repo root is not parent of container-agent folder
# CONTAINER_MANAGER_WORKSPACE_HOST_PATH=/srv/idp

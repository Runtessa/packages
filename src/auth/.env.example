NODE_ENV=development
AUTH_PORT=3015
AUTH_HOST=0.0.0.0
AUTH_BASE_URL=http://localhost:3015
AUTH_TRUST_PROXY=false
AUTH_COOKIE_NAME=idp_auth_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_SESSION_TTL_SEC=28800
AUTH_SESSION_IDLE_TTL_SEC=1800
AUTH_SESSION_SECRET=replace_with_long_random_secret
AUTH_ALLOW_INSECURE_LOCALHOST=true
AUTH_BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_LOGIN_MAX=20
AUTH_RATE_LIMIT_REGISTER_MAX=10
AUTH_RATE_LIMIT_OAUTH_MAX=120
AUTH_CODE_TTL_SEC=300
AUTH_ACCESS_TOKEN_TTL_SEC=3600
AUTH_OTP_TTL_SEC=300
AUTH_OTP_RESEND_INTERVAL_SEC=120
AUTH_OTP_SMS_PROVIDER=none
AUTH_OTP_SMS_GHASEDAK_API_KEY=
AUTH_OTP_SMS_GHASEDAK_TEMPLATE=adaidp
AUTH_OTP_SMS_GHASEDAK_IS_VOICE=false
AUTH_OTP_SMS_GHASEDAK_UDH=true
AUTH_ALLOWED_ORIGINS=http://localhost:3015,http://localhost:3002,http://localhost:3005
AUTH_DB_SSL=false
AUTH_TENANT_POLICY_URL=
AUTH_TENANT_POLICY_TOKEN=
AUTH_TENANT_POLICY_TIMEOUT_MS=3000
AUTH_TENANT_POLICY_REQUIRE_REMOTE=false
AUTH_INTERNAL_API_TOKEN=replace_with_shared_internal_token
AUTH_BOOTSTRAP_ON_START=true
DATABASE_URL=postgres://postgres:postgres@localhost:5432/idp_auth
AUTH_BOOTSTRAP_CLIENT_ID=idp-tenant-client
AUTH_BOOTSTRAP_CLIENT_SECRET=change-me-client-secret
AUTH_BOOTSTRAP_REDIRECT_URI=http://localhost:3002/auth
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
AUTH_BOOTSTRAP_TENANT_RAND_ID=tenant-default
AUTH_BOOTSTRAP_TENANT_CODE=default
AUTH_BOOTSTRAP_TENANT_NAME=Default Tenant
AUTH_BOOTSTRAP_TENANT_NAME_HOST=localhost
AUTH_BOOTSTRAP_TENANT_SSO_TOKEN=change-me-tenant-sso-token
AUTH_BOOTSTRAP_TENANT_ALLOW_REGISTRATION=true
AUTH_BOOTSTRAP_ORG_RAND_ID=tenant-default-org
AUTH_BOOTSTRAP_ORG_NAME=Default Organization
AUTH_BOOTSTRAP_ORG_CODE=default-org

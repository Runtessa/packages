{
  "compilerOptions": {
    "target": "ES2016",

    "module": "ESNext",

    "outDir": "./dist",
    "rootDir": "./src",

    "strict": true,
    "noImplicitAny": true,

    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "lib": ["dom", "es2016"],

    "sourceMap": true,

    "declaration": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules_", "dist", "**/*.test.ts"]
}
